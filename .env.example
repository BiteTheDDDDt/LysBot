# 只填写使用的服务，其他保持注释；不需要同时申请所有 API key。
# AI 首次部署读 AGENTS.md、QUICKSTART.md；能力/模型/费用见 docs/providers.md。
# 完整多模型组合见 .env.models.example；与本模板合并使用，不替代 QQ 配置和凭据。
# 密钥只留在本地 .env。修改后：docker compose up -d --force-recreate bot

# ===== 最小配置 =====
# 管理 LysBot 的个人 QQ 号，不是 bot 小号。
MASTER_QQ=
# 让 AI 生成长随机字符串，并配置到 NapCat 的反向 WebSocket 客户端。
ACCESS_TOKEN=replace-with-a-long-random-token
# provider:model_id；通用模型必须支持工具调用。
# 所有 MODEL_* 都可用 | 配多个候选，按从左到右失败回退；不要写成逗号。
# 下方为直连示意；采用推荐方案时替换本行，并注释 OPENAI_API_KEY。
MODEL_GENERAL=openai:your-model-id
OPENAI_API_KEY=your_api_key

# ===== 推荐：CLIProxyAPI + Codex 账号授权 =====
# AI 按 docs/cliproxyapi.md 部署；只启用账号实际可用且验证过的能力。
# 以下为候选组合，可先只配 MODEL_GENERAL，不保证每个账号都有权限。
# MODEL_GENERAL=cliproxyapi:gpt-6-luna
# MODEL_VISION=cliproxyapi:gpt-6-luna
# MODEL_SEARCH=cliproxyapi:gpt-6-luna
# MODEL_IMAGE_GEN=cliproxyapi:gpt-image-2
# CLIPROXYAPI_API_KEY=replace-with-your-local-proxy-key
# 同 Compose 网络用服务名；宿主机运行默认 http://127.0.0.1:8317/v1。
# CLIPROXYAPI_BASE_URL=http://cliproxyapi:8317/v1
# 这是本地代理访问密钥，须和代理配置一致，不是 OpenAI key / OAuth token。

# ===== 可选专用能力 =====
# 留空则关闭，不继承 general；能力白名单见 docs/providers.md。
# MODEL_VISION=google:gemma-4-31b-it
# MODEL_SEARCH=dashscope:qwen3.6-plus
# TTS 单独使用 Google 原生 API，需要 GOOGLE_API_KEY。
# MODEL_TTS=google:gemini-3.1-flash-tts-preview
# MODEL_IMAGE_GEN=openai:gpt-image-2

# ===== 文本角色与备用链 =====
# 以下不填时继承 MODEL_GENERAL；优先为 planner / chat 配强模型。
# planner 重行为决策逻辑，chat 重最终输出的语言风格；可用不同模型。
# Antigravity 的 Claude / Gemini 额度较少时，可优先分配给 MODEL_CHAT。
# 按账号可用型号启用下列示例，或保持注释以继承 general。
# MODEL_CHAT="tencentmaas:deepseek-v4.1-flash-1017 | tencentmaas:mimo-v2.6-pro | cliproxyapi:grok-4.7"
# MODEL_PLANNER=cliproxyapi:gpt-6.1-sol
# MODEL_SUMMARY="cliproxyapi:gpt-6-luna | google:gemini-3.5-flash-lite"
# MODEL_IMPORTANT_INFO=
# MODEL_FALLBACK="google:gemini-3.5-flash-lite | openrouter:nvidia/nemotron-3-ultra-550b-a55b:free"
# FALLBACK 仅追加到普通文本任务，不作为专用能力的备用。

# ===== 全部 12 个 provider：只取消需要的项的注释 =====
# BASE_URL 不填用代码默认值；这里列出默认地址以便定位地域/兼容服务。
# OpenAI：文本、已适配 GPT 原生搜索、GPT Image；兼容网关也可用此入口。
# OPENAI_API_KEY 已在最小配置中给出，不要重复定义。
# OPENAI_BASE_URL=https://api.openai.com/v1
# CLIProxyAPI 的 key / URL 见推荐方案。

# DeepSeek：文本 / 工具调用。例 deepseek:deepseek-flash
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 阿里云百炼：文本 / 原生搜索。地域、API key、模型须匹配。
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Google AI Studio：文本 / Gemma 识图 / 原生 TTS。
# GOOGLE_API_KEY=
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GOOGLE_TTS_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Anthropic：Claude 文本 / 工具调用，使用 Messages 协议。
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# NVIDIA NIM：文本 / 白名单视觉模型；开发试用有用途和速率限制。
# NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# OpenRouter：聚合平台；模型 ID 保留厂商前缀和 :free 等后缀。
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# SiliconFlow：中国站；文本 / 白名单视觉模型。国际站 key、地址需匹配。
# SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# 腾讯云 TokenHub：文本 / 工具调用。模型 ID 从控制台复制。
# TENCENTMAAS_API_KEY=
# TENCENTMAAS_BASE_URL=https://tokenhub.tencentmaas.com/v1
# 火山方舟：文本 / 工具调用。model_id 使用模型 ID 或推理接入点 ID。
# VOLC_API_KEY=
# VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 小米 MiMo：文本 / 工具调用；自动使用 api-key 请求头。
# XIAOMIMIMO_API_KEY=
# XIAOMIMIMO_BASE_URL=https://api.xiaomimimo.com/v1

# ===== 可选网络代理：与 CLIProxyAPI 模型网关不同 =====
# 未配置则直连；provider 级优先，direct 显式跳过全局代理。
# PROVIDER_PROXY_ALL=http://host.docker.internal:7890
# PROVIDER_PROXY_GOOGLE=http://host.docker.internal:7890
# PROVIDER_PROXY_CLIPROXYAPI=direct
# 容器里的 127.0.0.1 是容器自身；Linux 宿主机代理需配置可达地址。

# ===== 人设、定时功能与数据 =====
PERSONA_FILE=personas/phosphophyllite.toml
# 静态知识库，与聊天数据库并列。默认 knowledge/；留空关闭两个知识工具。
# 只读取 UTF-8 .md / .txt，所有群和私聊共用，勿放凭据或私人资料。
# Compose 默认只读挂载 ./knowledge；改宿主目录时同步调整挂载。
# KNOWLEDGE_DIR=knowledge
# 给 planner 的固定类别概述，不是实时文件目录；只有类别变化时才需要修改。
# KNOWLEDGE_OVERVIEW="项目信息；背景知识（领域资料、术语、设定）；skill（任务方法与步骤）"
# 新闻依赖简报与 MODEL_SEARCH；简报没有生图模型仍能生成正文。
ENABLE_DAILY_BRIEFING=false
ENABLE_DAILY_NEWS_BROADCAST=false
ENABLE_MODEL_CARD=false
# Compose 已设置 TZ=Asia/Shanghai。
# BRIEFING_TIME=00:00
# NEWS_BROADCAST_TIME=08:00
# 通常无需改数据路径；Compose 已指定 /app/data，本地 Python 默认 ./data。
# LLM_CHAT_DATA_DIR=./data
# LLM_CHAT_DATABASE_PATH=./data/history.db
# 本地向量模型固定，由 setup 准备；不需要 embedding API key。
