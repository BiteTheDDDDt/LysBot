# 必填：管理 LysBot 的个人 QQ 号（不是 bot 小号）。
MASTER_QQ=
# 与 NapCat WebSocket 客户端的 token 保持一致。
ACCESS_TOKEN=replace-with-a-long-random-token

# 只需一个通用模型及对应 provider 的凭据即可运行。
MODEL_GENERAL=openai:your-model-id
OPENAI_API_KEY=your_api_key
# 使用其他 OpenAI 兼容服务时设置其地址。
# OPENAI_BASE_URL=https://your-provider.example/v1

# 可选的专用模型。留空则不提供对应能力，不继承通用模型。
# MODEL_VISION=google:gemma-4-31b-it
# GOOGLE_API_KEY=your_google_api_key
# MODEL_SEARCH=dashscope:qwen3.6-plus
# DASHSCOPE_API_KEY=your_dashscope_api_key
# MODEL_TTS=google:gemini-3.1-flash-tts-preview
# MODEL_IMAGE_GEN=openai:gpt-image-2

# 进阶：高用量任务未填写时继承 MODEL_GENERAL。
# MODEL_CHAT=
# MODEL_PLANNER=
# MODEL_SUMMARY=
# MODEL_IMPORTANT_INFO=
# MODEL_FALLBACK=openai:your-backup-model

# 默认磷叶石人设；复制这个 TOML 后修改路径即可换人设。
PERSONA_FILE=personas/phosphophyllite.toml

# 三项可选功能。新闻依赖简报与 MODEL_SEARCH。
ENABLE_DAILY_BRIEFING=false
ENABLE_DAILY_NEWS_BROADCAST=false
ENABLE_MODEL_CARD=false
# BRIEFING_TIME=00:00
# NEWS_BROADCAST_TIME=08:00
