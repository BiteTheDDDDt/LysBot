# 多模型组合示例：与 .env.example 的 QQ 配置及 provider 凭据合并使用。
# 此文件只包含模型路由，不包含密钥、账号、地址或登录状态。
# 保留需要的候选，并配置对应 provider 的 API key；未配置凭据的候选会跳过。
# 同一行用 | 分隔，按从左到右的顺序失败回退，不是随机选择或负载均衡。
# 普通文本角色在自身链尾追加 MODEL_FALLBACK；专用能力只使用自己的链。

MODEL_GENERAL="cliproxyapi:gpt-6-luna"

MODEL_PLANNER="cliproxyapi:gpt-6.1-sol"
MODEL_CHAT="tencentmaas:deepseek-v4.1-flash-1017 | tencentmaas:mimo-v2.6-pro | cliproxyapi:grok-4.7 | google:gemini-4-argon | cliproxyapi:claude-sonnet-4-6 | dashscope:qwen3.8-max | cliproxyapi:gpt-6-luna"

MODEL_SUMMARY="cliproxyapi:gpt-6-luna | google:gemini-3.5-flash-lite"
MODEL_IMPORTANT_INFO="cliproxyapi:gpt-6-luna | google:gemini-3.5-flash-lite"
MODEL_FALLBACK="google:gemini-3.5-flash-lite | openrouter:nvidia/nemotron-3-ultra-550b-a55b:free"

MODEL_SEARCH="cliproxyapi:gpt-6-luna"
MODEL_VISION="cliproxyapi:gpt-6-luna | google:gemma-4-31b-it | nvidia:nvidia/nemotron-3-nano-omni-30b-a3b-reasoning | cliproxyapi:gpt-6-luna"
MODEL_TTS="google:gemini-3.1-flash-tts-preview"
MODEL_IMAGE_GEN="cliproxyapi:gpt-image-2.6-sunburst"

# MODEL_VISION 中末尾重复的 GPT 是再次尝试的候选，不会自动去重。
# 实际尝试受总超时、取消和接口冷却限制，不保证每次都能遍历完整条链。
# 对应的凭据名和默认 API 地址见 .env.example；只填写实际使用的服务。
